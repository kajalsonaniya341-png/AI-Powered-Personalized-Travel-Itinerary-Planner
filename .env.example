# Copy this file to .env and fill in real values. NEVER commit .env to GitHub.

# MongoDB Atlas connection string (Atlas > Connect > Drivers). Example shape:
# mongodb+srv://<db_user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Keep the literal text <password> in the string: the app then asks for the password in the
# terminal (visible, so you can check it) each time it starts, so it is never saved in a file.
# Example for this project's user:
# MONGODB_URI=mongodb+srv://t11550788_db_user:<password>@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
# Only for hosted servers (e.g. Render) where nobody can type a password. Leave unset locally.
# MONGODB_PASSWORD=

# Long random secret used to sign login tokens (at least 16 characters).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional
# Database name (default: travel_planner_db)
# MONGODB_DB_NAME=travel_planner_db
# Allowed browser origins if the frontend is hosted on a DIFFERENT domain (comma-separated).
# Leave empty when the FastAPI app serves the website itself (the default setup).
# CORS_ORIGINS=https://your-frontend.example.com
# Set to true to load/refresh the sample places (safe upserts) each time the server starts.
# SEED_ON_STARTUP=false

# ---- AI assistant (optional, real LLM) -------------------------------------------------
# Leave AI_API_KEY empty to keep the AI features switched off (the app still works).
# AI_PROVIDER: "anthropic" (Claude, key from console.anthropic.com) or "gemini" (key from aistudio.google.com)
# AI_MODEL: leave empty for the default, or set a model name your key can use.
# Never put this key in frontend code or GitHub. On Render, set it in the dashboard.
AI_PROVIDER=anthropic
AI_API_KEY=
# AI_MODEL=
# AI_RATE_LIMIT_PER_MINUTE=10
